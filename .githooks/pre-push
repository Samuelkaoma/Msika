#!/bin/sh
# Runs the fast checks before every push. Git for Windows runs hooks in its own bash, so this one
# file serves everyone. Do not skip it with --no-verify. If the hook is wrong, fix the hook.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running scripts/check.sh --fast"
exec sh scripts/check.sh --fast
