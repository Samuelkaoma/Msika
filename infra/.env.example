# Copy to infra/.env to override the local defaults. The .env file is ignored by git.
# These values are for a laptop only. A real server (card M-45) must use its own strong secrets.
POSTGRES_PASSWORD=dev_only_postgres
MSIKA_OWNER_PASSWORD=dev_only_msika_owner
MSIKA_APP_PASSWORD=dev_only_msika_app
ZAMSIM_PASSWORD=dev_only_zamsim
ELEVYSIM_PASSWORD=dev_only_elevysim

# Sign-in for msika-api. These have no defaults on purpose (this repository is public).
# MSIKA_AUTH_JWT_SECRET: Base64 of at least 32 random bytes, for example:  openssl rand -base64 32
#   If unset, a random secret is made at start-up and everyone is signed out when the app restarts.
# MSIKA_BOOTSTRAP_OPERATOR_*: creates the first operator (who creates councils) if that email does
#   not exist yet. Choose your own password (12+ characters), start the app once, then remove it.
MSIKA_AUTH_JWT_SECRET=
MSIKA_BOOTSTRAP_OPERATOR_EMAIL=
MSIKA_BOOTSTRAP_OPERATOR_PASSWORD=

# The key that signs each council's daily seal (Base64: PKCS#8 private key, X.509 public key).
# Leave empty on a laptop: a development key is generated and kept in .msika-keys/ (git ignores it).
# A real server must set both, and keep the private key out of the repository.
# Anyone with the PUBLIC key can check a seal: it is also shown at GET /api/v1/seal-key.
MSIKA_SEAL_PRIVATE_KEY=
MSIKA_SEAL_PUBLIC_KEY=

# zamsim's signed callbacks to Msika (card M-13). No defaults: this repository is public.
# ZAMSIM_CALLBACK_URL: where Msika receives them, for example http://msika-api:8080/api/v1/payments/callback
#   (that endpoint arrives in card M-14). Empty means callbacks are switched off.
# ZAMSIM_CALLBACK_SECRET: the shared signing secret. Both sides must use the same one. Make it long and random.
ZAMSIM_CALLBACK_URL=
ZAMSIM_CALLBACK_SECRET=
